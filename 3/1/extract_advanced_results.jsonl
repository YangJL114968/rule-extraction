{"ruleId": "R019", "rawText": "如果某账户连续3天夜间高频收款，则判定为疑似跑分账户风险。", "events": [{"id": "E1", "text": "夜间高频收款"}], "booleanLogic": "E1", "temporalLogic": ["DURATION(E1, 3天)"], "output": "疑似跑分账户风险"}
{"ruleId": "R020", "rawText": "如果某账户连续5天夜间高频收款，并且持续出现分散转账，则判定为疑似跑分账户风险。", "events": [{"id": "E1", "text": "某账户夜间高频收款"}, {"id": "E2", "text": "某账户出现分散转账"}], "booleanLogic": "E1 AND E2", "temporalLogic": ["DURATION(E1, 5天)"], "output": "疑似跑分账户风险"}
{"ruleId": "R021", "rawText": "如果企业获得大额贷款后，30天内没有采购行为，则判定为贷款用途异常风险。", "events": [{"id": "E1", "text": "企业获得大额贷款"}, {"id": "E2", "text": "有采购行为"}], "booleanLogic": "E1 AND NOT E2", "temporalLogic": ["TIMEOUT(E1, E2, 30天)"], "output": "贷款用途异常风险"}
{"ruleId": "R023", "rawText": "如果企业存在虚假贸易合同，随后银行放款，再发生多层转账并最终资金回流，则判定为疑似骗贷链路风险。", "events": [{"id": "E1", "text": "企业存在虚假贸易合同"}, {"id": "E2", "text": "银行放款"}, {"id": "E3", "text": "发生多层转账"}, {"id": "E4", "text": "最终资金回流"}], "booleanLogic": "E1 AND E2 AND E3 AND E4", "temporalLogic": ["CAUSAL_CHAIN(E1, E2, E3, E4)"], "output": "疑似骗贷链路风险"}
