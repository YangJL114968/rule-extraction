{"ruleId": "R011", "rawText": "如果企业获得大额贷款，之后发生资金快速转出，则判定为疑似异常融资风险。", "events": [{"id": "E1", "text": "企业获得大额贷款"}, {"id": "E2", "text": "资金快速转出"}], "booleanLogic": "E1 AND E2", "temporalLogic": ["SEQUENCE(E1, E2)"], "output": "疑似异常融资风险"}
{"ruleId": "R012", "rawText": "如果企业获得大额贷款，并且在30天内发生资金快速转出，则判定为疑似异常融资风险。", "events": [{"id": "E1", "text": "企业获得大额贷款"}, {"id": "E2", "text": "发生资金快速转出"}], "booleanLogic": "E1 AND E2", "temporalLogic": ["SEQUENCE(E1, E2)", "WITHIN(E2, 30天)"], "output": "疑似异常融资风险"}
{"ruleId": "R013", "rawText": "如果企业获得大额贷款，并且在30天内发生资金分拆转出和关联方接收资金，则判定为疑似利益输送风险。", "events": [{"id": "E1", "text": "企业获得大额贷款"}, {"id": "E2", "text": "发生资金分拆转出"}, {"id": "E3", "text": "关联方接收资金"}], "booleanLogic": "E1 AND E2 AND E3", "temporalLogic": ["SEQUENCE(E1, E2)", "SEQUENCE(E1, E3)", "WITHIN(E2, 30天)", "WITHIN(E3, 30天)"], "output": "疑似利益输送风险"}
{"ruleId": "R014", "rawText": "如果企业发生大额资金流转，之后不是正常贸易付款，而是流向关联方，则判定为疑似异常资金流风险。", "events": [{"id": "E1", "text": "企业发生大额资金流转"}, {"id": "E2", "text": "资金流转是正常贸易付款"}, {"id": "E3", "text": "资金流向关联方"}], "booleanLogic": "E1 AND NOT E2 AND E3", "temporalLogic": ["SEQUENCE(E1, E3)"], "output": "疑似异常资金流风险"}
{"ruleId": "R015", "rawText": "如果企业存在多层账户转账，或者存在空壳公司收款，并且在15天内资金回流原主体，则判定为疑似资金空转风险。", "events": [{"id": "E1", "text": "企业存在多层账户转账"}, {"id": "E2", "text": "存在空壳公司收款"}, {"id": "E3", "text": "资金回流原主体"}], "booleanLogic": "(E1 OR E2) AND E3", "temporalLogic": ["WITHIN(E3, 15天)"], "output": "疑似资金空转风险"}
{"ruleId": "R016", "rawText": "如果企业发生资产高溢价交易，并且在交易之后10天内出现关联交易对手收款，则判定为疑似关联交易风险。", "events": [{"id": "E1", "text": "企业发生资产高溢价交易"}, {"id": "E2", "text": "出现关联交易对手收款"}], "booleanLogic": "E1 AND E2", "temporalLogic": ["SEQUENCE(E1, E2)", "WITHIN(E2, 10天)"], "output": "疑似关联交易风险"}
{"ruleId": "R017", "rawText": "如果企业获得贷款之后，先发生多级账户流转，随后发生资产回购行为，则判定为疑似贷款用途异常风险。", "events": [{"id": "E1", "text": "企业获得贷款"}, {"id": "E2", "text": "发生多级账户流转"}, {"id": "E3", "text": "发生资产回购行为"}], "booleanLogic": "E1 AND E2 AND E3", "temporalLogic": ["SEQUENCE(E1, E2)", "SEQUENCE(E2, E3)"], "output": "疑似贷款用途异常风险"}
{"ruleId": "R018", "rawText": "如果企业存在工商异常信息，并且在20天内出现涉诉信息增加或者税务异常记录，则判定为疑似企业综合风险。", "events": [{"id": "E1", "text": "企业存在工商异常信息"}, {"id": "E2", "text": "出现涉诉信息增加"}, {"id": "E3", "text": "出现税务异常记录"}], "booleanLogic": "E1 AND (E2 OR E3)", "temporalLogic": ["SEQUENCE(E1, E2)", "WITHIN(E2, 20天)", "SEQUENCE(E1, E3)", "WITHIN(E3, 20天)"], "output": "疑似企业综合风险"}
